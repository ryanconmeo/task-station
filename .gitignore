# User task data is private and machine-local — never commit it.
store/

# delegate runtime registry (live worker session ids) — machine-local, not committed.
delegate/workers.json

# Worker briefs and the reports they hand back are per-run scratch, not shipped artifacts —
# they live in the worktree only. The report half matters as much as the brief: a delegated
# worker has no Bash, so a report FILE is its only channel back to the hub (a backgrounded
# run loses its stdout), which means these are written on every delegation, not occasionally.
BRIEF-*.md
REPORT-*.md
# …and since 3.1.0 that report is MECHANIZED, not a convention: delegate contracts
# every worker to write HANDOFF-REPORT-<slug>.md here and harvests its final message
# into the same file when it doesn't.
HANDOFF-REPORT-*.md

# macOS Finder metadata
.DS_Store

# Python bytecode caches. Never committed: they are per-interpreter build output
# (a py3.13 run and a py3.9 run write different files for identical source), and
# a `git add -A` in a worktree where the suite has been run will otherwise sweep
# dozens of them into a commit.
__pycache__/
*.py[cod]
