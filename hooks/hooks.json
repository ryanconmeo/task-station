{
  "hooks": {
    "SessionStart": [
      { "hooks": [
        { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/on_session_start.sh\"" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/on_user_prompt.sh\"" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit|NotebookEdit", "hooks": [
        { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/on_post_tool.sh\"" } ] }
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/on_stop.sh\"" } ] }
    ],
    "PostCompact": [
      { "matcher": "manual", "hooks": [
        { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/on_post_compact.sh\"" } ] },
      { "matcher": "auto", "hooks": [
        { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/on_post_compact.sh\"" } ] }
    ],
    "SessionEnd": [
      { "hooks": [
        { "type": "command", "timeout": 10, "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/on_session_end.sh\"" } ] }
    ],
    "ConfigChange": [
      { "matcher": "user_settings", "hooks": [
        { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/on_config_change.sh\"" } ] },
      { "matcher": "project_settings", "hooks": [
        { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/on_config_change.sh\"" } ] },
      { "matcher": "local_settings", "hooks": [
        { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/on_config_change.sh\"" } ] }
    ],
    "FileChanged": [
      { "matcher": "config.json|categories.json|repos.json|brains.json|workers.json", "hooks": [
        { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/on_file_changed.sh\"" } ] }
    ]
  }
}
